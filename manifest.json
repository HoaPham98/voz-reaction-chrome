{
  "manifest_version": 3,
  "name": "Voz Reaction",
  "version": "0.1.0",
  "description": "Chrome extension tăng cường trải nghiệm diễn đàn Voz (reaction, quick tools).",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.voz.vn/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Voz Reaction",
    "default_icon": {
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "32": "icons/icon-32.png"
  },
  "content_scripts": [
    {
      "matches": ["*://*.voz.vn/*"],
      "js": ["api.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon-32.png"],
      "matches": ["*://*.voz.vn/*"]
    }
  ]
}
